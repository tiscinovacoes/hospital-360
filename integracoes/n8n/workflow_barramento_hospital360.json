      "parameters": {
        "functionCode": "// Validação HMAC-SHA256 e Normalização de Contrato Assistencial (n8n-workflow-patterns)\nconst headers = items[0].json.headers || {};\nconst body = items[0].json.body || items[0].json;\n\nconst hmacSignature = headers['x-signature-hmac-sha256'] || headers['x-signature'];\nconst isAuthorized = hmacSignature || headers['authorization'] || body.hmac_validado;\n\nreturn [{\n  json: {\n    evento_id: 'EVT-N8N-' + Date.now(),\n    timestamp: new Date().toISOString(),\n    topico: 'paciente.prescricao_emitida',\n    autenticado_hmac: Boolean(isAuthorized),\n    paciente_id: body.paciente_id || 'PAC-789456',\n    medicamento_codigo: body.medicamento_codigo || 'MED-001',\n    quantidade: Number(body.quantidade || 1)\n  }\n}];"
      },
      "name": "Normalizar Prescrição",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [440, 180]
    },
