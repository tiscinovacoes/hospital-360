# ============================================================================
# HOSPITAL 360 - TEMPLATE DE VARIÁVEIS DE AMBIENTE (SEGURO / SANITIZADO)
# Governança: cred-omega & security-auditor (NUNCA COMMITAR ARQUIVOS .env REAIS)
# ============================================================================

# Supabase (Banco de Dados & RLS)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_apenas_backend

# Barramento n8n & Assinatura de Webhooks
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_HMAC_SECRET_KEY=sua_chave_secreta_hmac_sha256_aqui

# Hyperswitch Fintech (Multi-Gateway)
HYPERSWITCH_API_BASE_URL=http://localhost:8080
HYPERSWITCH_API_KEY=sua_chave_api_hyperswitch

# Poli WhatsApp CRM (Baileys)
POLI_ZAP_APP_URL=http://localhost:8090
POLI_ZAP_API_TOKEN=seu_token_baileys_whatsapp

# Ambiente & Observabilidade
NODE_ENV=production
PROMETHEUS_METRICS_ENABLED=true
